FRONTEND_PORT=8000
API_PORT=8001

# Endereço de escuta ao executar o Python diretamente.
# O Compose configura a escuta interna e publica as portas apenas localmente.
HOST=localhost

# Diretório de semestres ou arquivo JSON dentro de data/.
DATA_PATH=data/ufca

# DEBUG, INFO, WARNING, ERROR ou CRITICAL.
LOG_LEVEL=INFO
